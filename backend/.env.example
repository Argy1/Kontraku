# Salin file ini jadi ".env" lalu sesuaikan. File .env TIDAK ikut ke git.

# --- Database ---
# Lokal (docker-compose.yml) — port 5433 di host, lihat catatan di compose file:
DATABASE_URL=postgresql://kontraku:kontraku@localhost:5433/kontraku
# Nanti di Railway: salin "Postgres Connection URL" dari dashboard.
# Format "postgresql://..." atau "postgres://..." dua-duanya diterima.

# --- Auth ---
SECRET_KEY=ganti-dengan-random-string-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Umum ---
ENVIRONMENT=development
CORS_ORIGINS=*

# --- Adapter layanan luar ---
# storage: local | cloudinary        push: log | fcm        email: console | smtp
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/uploads
PUBLIC_BASE_URL=http://localhost:8000
PUSH_BACKEND=log
EMAIL_BACKEND=console

# --- Scheduler (cron harian penyegar reminder otomatis) ---
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# --- Diisi nanti saat pakai layanan asli ---
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# FCM_CREDENTIALS_JSON=./secrets/firebase-service-account.json
# GOOGLE_MAPS_API_KEY=...
